{
  "openapi": "3.2.0",
  "info": {
    "title": "Test Shop",
    "description": "The shop's API, for its tests.",
    "version": "1.2.3"
  },
  "paths": {
    "/api/items/{itemId}": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Get an item",
        "description": "The item, with its size.",
        "operationId": "Items_Get",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "description": "The item's id, such as \"42\".",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-position": 1
          }
        ],
        "responses": {
          "200": {
            "description": "The item.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/items": {
      "post": {
        "tags": [
          "Items"
        ],
        "summary": "Add an item",
        "operationId": "Items_Create",
        "requestBody": {
          "description": "The item to add.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreateRequest"
              }
            }
          },
          "required": true,
          "x-name": "request",
          "x-position": 1
        },
        "responses": {
          "200": {
            "description": "The new item.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "List the items",
        "operationId": "Items_List",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "description": "How many items a page holds.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            },
            "x-position": 1
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResultOfItem"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/items/count": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Count the items",
        "description": "Open to anyone.",
        "operationId": "Items_Count",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/sizes": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "List the sizes",
        "operationId": "Items_ListSizes",
        "responses": {
          "200": {
            "description": "The sizes an item comes in, by name.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemSize"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/shop": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_GetShop",
        "responses": {
          "200": {
            "description": "",
