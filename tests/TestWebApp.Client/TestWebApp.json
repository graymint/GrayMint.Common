                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/orders/total": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_GetTotal",
