        ]
      }
    },
    "/api/orders/callback": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_CallbackGET",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_CallbackPOST",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/shops/{shopId}/orders/{orderId}/notes": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_AddNote",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-position": 1
          },
          {
            "name": "author",
            "in": "query",
            "schema": {
              "type": [
                "null",
                "string"
              ]
            },
            "x-position": 3
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-position": 4
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          },
          "x-name": "order",
          "x-position": 2
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/orders/upload": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_Upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "File": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "WeatherForecast_Get",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "IPAddress": {
        "examples": [
          "192.168.1.10 or 2001:db8::1"
        ],
        "type": "string",
        "additionalProperties": false,
        "format": "ip"
      },
      "Item": {
        "required": [
          "itemId",
          "name",
          "size"
        ],
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "description": "The item's id; `*/*` names any item."
          },
          "name": {
            "type": "string",
            "description": "The item's name."
          },
          "size": {
            "description": "How big the item is.",
            "$ref": "#/components/schemas/ItemSize"
          }
        },
        "additionalProperties": false,
        "description": "An item of the shop."
      },
      "ItemCreateRequest": {
        "required": [
          "name",
          "size"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The item's name."
          },
          "size": {
            "description": "How big the item is.",
            "$ref": "#/components/schemas/ItemSize"
          },
          "note": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PatchOfString"
              }
            ],
            "description": "A note on the item, if it has one."
          }
        },
        "additionalProperties": false,
        "description": "An item to add."
      },
      "ItemSize": {
        "enum": [
          "Small",
          "Large"
        ],
        "type": "string",
        "description": "How big an item is.\n\n- `Small`: Fits in a hand.\n- `Large`: Takes two hands."
      },
      "Label": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Label2": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LegacyBox": {
        "type": "object",
        "properties": {
          "label": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Label"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ListResultOfItem": {
        "required": [
          "items",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "description": "The items of this page."
          },
          "totalCount": {
            "type": "integer",
            "description": "How many items match, on every page together.",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "One page of a list, and how many items match in all."
      },
      "Order": {
        "required": [
          "orderId",
          "clientIp",
          "state",
          "price",
          "extras",
          "tags",
          "priority",
          "channel"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "previousState": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OrderState"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/OrderState"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "extras": {
            "type": "object",
            "additionalProperties": { }
          },
          "note": {
            "nullable": true
          },
          "label": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Label"
              }
            ]
          },
          "clientIp": {
            "$ref": "#/components/schemas/IPAddress"
          },
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          },
          "totals": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OrderTotals"
              }
            ]
          },
          "data": {
            "nullable": true
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "priority": {
            "$ref": "#/components/schemas/OrderPriority"
          },
          "channel": {
            "$ref": "#/components/schemas/OrderChannel"
          }
        },
        "additionalProperties": false
      },
      "OrderBase": {
        "required": [
          "orderId"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrderChannel": {
        "enum": [
          "web-shop",
          "Phone"
        ],
        "type": "string",
        "x-enumNames": [
          "Web",
          "Phone"
        ]
      },
      "OrderLine": {
        "required": [
          "quantity"
        ],
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "order": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Order"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "OrderPriority": {
        "enum": [
          0,
          5
        ],
        "type": "integer",
        "x-enumNames": [
          "Low",
          "High"
        ]
      },
      "OrderState": {
        "enum": [
          "Open",
          "Closed"
        ],
        "type": "string"
      },
      "OrderSummary": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderBase"
          },
          {
            "required": [
              "lineCount"
            ],
            "type": "object",
            "properties": {
              "lineCount": {
                "type": "integer",
                "format": "int32"
              },
              "giftLabel": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Label2"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "OrderTotals": {
        "required": [
          "items",
          "paid"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "paid": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "PatchOfString": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "null",
              "string"
            ],
            "description": "The field's new value."
          }
        },
        "additionalProperties": false,
        "description": "A change to one field, as `{ \"value\": ... }`. Leave the field out to keep its value."
      },
      "Shop": {
        "type": "object",
        "properties": {
          "orders": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "required": [
          "date",
          "temperatureC",
          "temperatureF"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "ipAddress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IPAddress"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste your JWT token here. Do not include the 'Bearer' prefix.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Items",
      "description": "The shop's items.\n\nEach item has a name and a size.",
      "x-displayName": "Shop items"
    },
    {
      "name": "Orders"
    },
    {
      "name": "WeatherForecast"
    }
  ]
}