          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/components/schemas/Order"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/orders/latest": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_GetLatest",
        "responses": {
