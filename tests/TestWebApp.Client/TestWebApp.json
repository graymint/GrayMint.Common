          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "format": "decimal"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/orders/count": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_Count",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": [
                    "null",
                    "integer"
                  ],
                  "format": "int32"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/orders/summary": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_GetSummary",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/orders/legacy": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "Orders_GetLegacy",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyBox"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
