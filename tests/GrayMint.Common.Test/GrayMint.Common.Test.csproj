<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test settings (IsPackable=false, language defaults) come from tests/Directory.Build.props.
       Explicit test PackageReferences (not MSTest.Sdk) so the daily NuGet updater can upgrade them. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GrayMint.Common\GrayMint.Common.csproj" />
    <ProjectReference Include="..\..\src\GrayMint.Common.Acme\GrayMint.Common.Acme.csproj" />
    <ProjectReference Include="..\..\src\GrayMint.Common.AspNetCore\GrayMint.Common.AspNetCore.csproj" />
    <!-- a web app on GrayMint.Common.OpenApi, for its Scalar page -->
    <ProjectReference Include="..\TestWebApp\TestWebApp.csproj" />
  </ItemGroup>
</Project>
