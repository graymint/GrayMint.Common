<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Shared test settings (IsPackable=false, language defaults) come from tests/Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the API's description takes its words from the doc comments, the app's and its packages' -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- TestWebApp.Client's build has the document written; a build of this project alone writes none -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's build-time document generator, which TestWebApp.Client's build calls -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GrayMint.Common.AspNetCore\GrayMint.Common.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\GrayMint.Common.OpenApi\GrayMint.Common.OpenApi.csproj" />
  </ItemGroup>
</Project>
