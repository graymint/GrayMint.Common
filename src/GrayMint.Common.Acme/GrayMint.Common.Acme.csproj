<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version, language and package metadata come from src/Directory.Build.props. -->
  <PropertyGroup>
    <Description>Let's Encrypt certificates over ACME's HTTP-01 challenge: the account, the order with a check of port 80 first, the challenge's answer in ASP.NET Core, and Kestrel's certificate for each domain of a connection</Description>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- the challenge's middleware and Kestrel's TLS callback -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GrayMint.Common.Test" />
  </ItemGroup>
</Project>
